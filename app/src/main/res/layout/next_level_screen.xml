<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/Grey">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="8dp"
        app:cardCornerRadius="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="أحسنت, لقد أكملت المرحلة بنجاح"
                android:textSize="20dp"
                android:textColor="@color/Red"
                android:gravity="center"/>

            <Button
                android:id="@+id/btn_cardsgame_nextlevel"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/design_btn"
                android:drawableRight="@drawable/ic_playagain"
                android:text="الــمــرحلة التـــالية"
                android:textColor="@color/White"
                android:textSize="18dp"
                android:minWidth="200dp"
                android:layout_gravity="center"
                android:padding="5dp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_cardsgame_close"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/design_btn"
                android:drawableRight="@drawable/ic_close"
                android:text="إغــــــلاق"
                android:textColor="@color/White"
                android:textSize="18dp"
                android:minWidth="200dp"
                android:layout_gravity="center"
                android:padding="5dp"
                android:textStyle="bold"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>


</FrameLayout>